{
  "name": "lumaflux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "description": "A local photo editor with MCP automation",
  "author": "Lumaflux",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "package": "npm run build && electron-builder --dir",
    "mcp": "node dist/mcp/stdio.js"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "exif-reader": "^2.0.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "app.lumaflux.desktop",
    "productName": "Lumaflux",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.photography"
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "dist/mcp/stdio.js",
        "to": "mcp/stdio.mjs"
      }
    ]
  }
}
